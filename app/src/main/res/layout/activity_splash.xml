<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_gradient">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/img_splash"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/txtAds"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/dashRing"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_dashed_ring"
                app:layout_constraintBottom_toBottomOf="@id/imgHero"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="@id/imgHero"
                app:layout_constraintStart_toStartOf="@id/imgHero"
                app:layout_constraintTop_toTopOf="@id/imgHero"
                app:layout_constraintWidth_percent="0.92" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgHero"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_splash_hero"
                app:layout_constraintDimensionRatio="270:350"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.69"
                app:shapeAppearanceOverlay="@style/PicsGenHeroShape"
                app:strokeColor="#00000000" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="-4dp"
                android:rotation="-8"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:layout_constraintDimensionRatio="96:136"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgHero"
                app:layout_constraintWidth_percent="0.246"
                app:strokeColor="@color/white"
                app:strokeWidth="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_splash_card_1" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="-18dp"
                android:rotation="-3"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:layout_constraintDimensionRatio="96:136"
                app:layout_constraintStart_toEndOf="@id/card1"
                app:layout_constraintTop_toBottomOf="@id/imgHero"
                app:layout_constraintWidth_percent="0.246"
                app:strokeColor="@color/white"
                app:strokeWidth="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_splash_card_2" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="-12dp"
                android:rotation="3"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:layout_constraintDimensionRatio="96:136"
                app:layout_constraintStart_toEndOf="@id/card2"
                app:layout_constraintTop_toBottomOf="@id/imgHero"
                app:layout_constraintWidth_percent="0.246"
                app:strokeColor="@color/white"
                app:strokeWidth="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_splash_card_3" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="-28dp"
                android:rotation="7"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:layout_constraintDimensionRatio="96:136"
                app:layout_constraintStart_toEndOf="@id/card3"
                app:layout_constraintTop_toBottomOf="@id/imgHero"
                app:layout_constraintWidth_percent="0.246"
                app:strokeColor="@color/white"
                app:strokeWidth="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_splash_card_4" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:includeFontPadding="false"
                    android:text="@string/brand_ai"
                    android:textColor="@color/color_brand_text"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:includeFontPadding="false"
                    android:text="@string/brand_photo"
                    android:textColor="@color/color_brand"
                    android:textSize="32sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/medium"
                android:includeFontPadding="false"
                android:text="@string/splash_tagline"
                android:textColor="@color/color_muted"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBrand" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:resize_mode="zoom"
            app:use_controller="false" />

        <TextView
            android:id="@+id/txtAds"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/ads_are_about_to_be_shown"
            android:textColor="@color/color_muted"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/progressSplash"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ProgressBar
            android:id="@+id/progressSplash"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="16dp"
            android:max="100"
            android:progress="35"
            android:progressDrawable="@drawable/bg_splash_progress"
            app:layout_constraintBottom_toTopOf="@id/fr_banner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:id="@+id/fr_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include
                android:id="@+id/include_banner"
                layout="@layout/layout_banner_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
