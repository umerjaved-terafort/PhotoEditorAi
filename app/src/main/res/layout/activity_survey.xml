<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_gradient">

        <RelativeLayout
            android:id="@+id/rlTop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_Back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_16sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_back"
                app:tint="@color/textPrimary" />

        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/fr_ads"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rlTop">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIllustration"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_survey" />

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/text_bold_16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:gravity="center"
                    android:text="@string/issues_encountered_during_usage"
                    android:textColor="@color/color_brand_text"
                    android:textSize="21sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivIllustration" />

                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_24sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle">

                    <RadioButton
                        android:id="@+id/rbFeature"
                        style="@style/text_regular_12"
                        android:layout_width="match_parent"
                        android:button="@drawable/bg_radio_language"
                        android:gravity="center|start"
                        android:minHeight="46dp"
                        android:paddingVertical="8dp"
                        android:text="@string/survey_1"
                        android:textColor="@color/color_brand_text"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbAds"
                        style="@style/text_regular_12"
                        android:layout_width="match_parent"
                        android:button="@drawable/bg_radio_language"
                        android:checked="true"
                        android:gravity="center|start"
                        android:minHeight="46dp"
                        android:paddingVertical="8dp"
                        android:text="@string/survey_2"
                        android:textColor="@color/color_brand_text"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbDontNeed"
                        style="@style/text_regular_12"
                        android:layout_width="match_parent"
                        android:button="@drawable/bg_radio_language"
                        android:gravity="center|start"
                        android:minHeight="46dp"
                        android:paddingVertical="8dp"
                        android:text="@string/survey_3"
                        android:textColor="@color/color_brand_text"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbOther"
                        style="@style/text_regular_12"
                        android:layout_width="match_parent"
                        android:button="@drawable/bg_radio_language"
                        android:gravity="center|start"
                        android:minHeight="46dp"
                        android:paddingVertical="8dp"
                        android:text="@string/survey_4"
                        android:textColor="@color/color_brand_text"
                        android:textSize="15sp" />

                </RadioGroup>

                <LinearLayout
                    android:id="@+id/bottomButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_20sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/radioGroup">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancel"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:text="@string/txt_cancel"
                        android:textAllCaps="false"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/_12ssp"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="26dp"
                        app:strokeColor="@color/color_stroke_soft"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUninstall"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:text="@string/txt_uninstall"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_12ssp"
                        app:backgroundTint="@color/color_brand"
                        app:cornerRadius="26dp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/fr_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include
                android:id="@+id/shimmer_ads"
                layout="@layout/layout_shimmer_native_medium" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
